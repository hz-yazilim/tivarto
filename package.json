    "pg": "^8.23.1",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "@vercel/blob": "^2.8.2",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
