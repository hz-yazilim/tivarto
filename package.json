    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3"
