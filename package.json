{
  "name": "tivarto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/production-setup.mjs && node scripts/prisma-generate.mjs && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:rls": "node scripts/apply-rls.mjs",
    "db:app-role": "node scripts/create-app-role.mjs",
    "db:setup": "node scripts/migrate.mjs && node scripts/apply-rls.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "db:clean-demo": "node scripts/clean-demo-data.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
