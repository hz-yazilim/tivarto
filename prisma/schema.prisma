generator client {
  provider        = "prisma-client-js"
  // Rust'suz istemci: native query engine ikilisi indirilmez/kullanılmaz.
  // Sorgular WASM query compiler + @prisma/adapter-pg üzerinden çalışır.
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  STAFF
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AccountDeletionRequestStatus {
  PENDING_VERIFICATION
  VERIFIED
  PROCESSING
  COMPLETED
  REJECTED
}

// ---------- Platform seviyesi (tenant_id YOK) ----------

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  priceMonthly Int      // TL cinsinden aylık ücret
  maxProducts  Int
  maxStorageMb Int
  tenants      Tenant[]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  isPlatformAdmin Boolean   @default(false)
  isSuspended    Boolean   @default(false)
  mustChangePassword Boolean @default(false)
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  sessions      Session[]
  supportTickets SupportTicket[]
  accountDeletionRequests AccountDeletionRequest[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  // Oturum açıkken seçili işletme (tenant seçimi oturumda taşınır).
  activeTenantId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ---------- Tenant verisi (tenantId'li + RLS) ----------

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  planId    String
  plan      Plan         @relation(fields: [planId], references: [id])
  createdAt DateTime     @default(now())

  memberships     Membership[]
  categories      Category[]
  products        Product[]
  stockMovements  StockMovement[]
  orders          Order[]
  customers       Customer[]
  suppliers       Supplier[]
  auditLogs       AuditLog[]
  storeSettings   StoreSettings?
  payments        Payment[]
  goodsReceipts   GoodsReceipt[]
  supportTickets  SupportTicket[]
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     Role
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}

model StoreSettings {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  logoUrl       String?
  coverUrl      String?
  description   String?
  phone         String?
  whatsapp      String?
  address       String?
  mapsUrl       String?
  theme         String  @default("default")
}

model Category {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  sortOrder Int      @default(0)
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  description String?
  imageUrl    String?
  barcode     String?
  sku         String?
  buyPrice    Decimal? @db.Decimal(12, 2)
  sellPrice   Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  category   Category?            @relation(fields: [categoryId], references: [id])
  movements  StockMovement[]
  orderItems OrderItem[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([tenantId])
  @@index([tenantId, barcode])
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  productId String
  type      StockMovementType
  quantity  Int
  note      String?
  createdBy String?
  createdAt DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, productId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@index([tenantId])
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  goodsReceipts  GoodsReceipt[]

  @@index([tenantId])
}

enum GoodsReceiptStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

model GoodsReceipt {
  id          String                 @id @default(cuid())
  tenantId    String
  supplierId  String?
  status      GoodsReceiptStatus     @default(PENDING)
  note        String?
  receivedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  items GoodsReceiptItem[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model GoodsReceiptItem {
  id             String   @id @default(cuid())
  tenantId       String
  receiptId      String
  productId      String
  expectedQuantity Int
  receivedQuantity Int     @default(0)
  missingQuantity  Int     @default(0)
  damagedQuantity  Int     @default(0)
  note           String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, receiptId])
  @@index([receiptId])
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  customerId    String?
  status        OrderStatus @default(NEW)
  customerName  String
  customerPhone String
  customerAddress String?
  note          String?
  total         Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items  OrderItem[]

  @@index([tenantId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  productId String
  name      String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, orderId])
  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Decimal  @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  description String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}


// ---------- Platform operasyon merkezi ----------

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  enabled     Boolean  @default(false)
  category    String   @default("product")
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  reason     String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model SupportTicket {
  id             String               @id @default(cuid())
  tenantId       String
  createdById    String?
  subject        String
  description    String
  status         SupportTicketStatus  @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  resolutionNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  creator User?  @relation(fields: [createdById], references: [id])

  @@index([tenantId, createdAt])
  @@index([status, priority, createdAt])
  @@index([createdById])
}


// External Google Play account-deletion requests. Tokens are stored as hashes;
// the user relation is nullable so the request can remain as a minimal audit
// record after the user account has been deleted.
model AccountDeletionRequest {
  id                 String                       @id @default(cuid())
  userId             String?
  tokenHash          String?                      @unique
  requestFingerprint String
  status             AccountDeletionRequestStatus @default(PENDING_VERIFICATION)
  expiresAt          DateTime
  verifiedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime                     @default(now())
  user               User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([requestFingerprint, createdAt])
  @@index([status, createdAt])
}
