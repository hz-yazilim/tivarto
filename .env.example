# ---- Veritabanı ----
# Gerçek veritabanına geçerken bu iki bağlantıyı tanımlayın.
DATABASE_URL="postgresql://tiverto_app:SIFRE@localhost:5432/tivarto"
DIRECT_URL="postgresql://postgres:SIFRE@localhost:5432/tivarto"

# ---- Uygulama ----
NEXT_PUBLIC_ROOT_DOMAIN=""

# Geliştirme önizlemesi: veritabanı olmadan örnek panelleri açar.
# DEMO_FAKE_DATA=true, DATABASE_URL tanımlı olsa bile bellek içi veriyi zorlar.
# Gerçek veritabanına geçerken ikisini de false yapın.
DEMO_MODE="false"
DEMO_FAKE_DATA="false"

# İlk platform yöneticisi oluşturma: yalnızca bir kez çalıştırın, sonra parolayı kaldırın.
# BOOTSTRAP_ADMIN_EMAIL="sizin-kullandiginiz-e-posta"
# BOOTSTRAP_ADMIN_PASSWORD="en-az-14-karakterli-guclu-bir-parola"

# Vercel Blob token is automatically provided by the connected Blob store.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---- Hesap silme e-postası (Google Play dış talep akışı) ----
# Resend hesabında doğrulanmış gönderici adresi kullanın.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Tivarto <hesap@your-verified-domain>"
NEXT_PUBLIC_APP_URL="https://tivarto.vercel.app"
# IP tabanlı istek sınırı parmak izi için uzun, rastgele bir gizli değer.
ACCOUNT_DELETION_RATE_LIMIT_SALT="uzun-rastgele-gizli-deger"
