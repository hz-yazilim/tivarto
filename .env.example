# ---- Veritabanı ----
# Uygulama bağlantısı: RLS'in çalışması için bu kullanıcı SUPERUSER OLMAMALIDIR.
DATABASE_URL="postgresql://tiverto_app:SIFRE@localhost:5432/tiverto"
# Migration / RLS için yönetici (superuser) bağlantısı.
DIRECT_URL="postgresql://postgres:SIFRE@localhost:5432/tiverto"

# ---- Uygulama ----
# Vitrinlerin subdomain kökü (örn. tiverto.app). Boş bırakılırsa subdomain
# yönlendirmesi kapalıdır; vitrinler /shop/[slug] üzerinden çalışır.
NEXT_PUBLIC_ROOT_DOMAIN=""

# Demo bilgilendirmesini gizlemek için false yapın.
DEMO_MODE="true"

# Veritabanı BAĞLI DEĞİLKEN demo katmanı (örnek veri + doğrulanmayan giriş)
# otomatik açılır: DATABASE_URL tanımlı değilse paneller örnek verilerle çalışır.
# DATABASE_URL tanımlandığı anda bu davranış OTOMATİK KAPANIR (güvenlik).
# DB tanımlı ama erişilemiyorsa demo verisini zorlamak için açın:
# DEMO_FAKE_DATA="true"
# ⚠️ Gerçek kullanımda DEMO_MODE=false ve DEMO_FAKE_DATA tanımsız olmalı.

# Demo hesapların şifresi (db:seed).
SEED_PASSWORD="Tiverto!2026"
